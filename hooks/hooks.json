{
  "description": "build-fleet SDD gates: block source writes until FINALIZED, confine reviewers to .sdd/ during non-workflow REVIEW/CHANGE_REVIEW (workflow paths skip via .workflow-in-flight marker), validate spec STATUS + required sections, require reviewer REVIEW.md entries on non-workflow paths, refuse Stop on failing tests while a feature is active, reap orphaned .workflow-in-flight markers on Stop.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-source-before-finalized.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/restrict-reviewer-writes.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-spec-status.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-review-written.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-tests.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/reap-stale-workflow-markers.sh\""
          }
        ]
      }
    ]
  }
}
