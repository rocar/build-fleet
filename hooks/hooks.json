{
  "description": "build-fleet SDD gates: block ALL non-.sdd writes until the spec is FINALIZED (or, in the bug lane, all non-.sdd/non-tests writes until diagnosis.md is CONFIRMED + a reproducing test exists), guard the Bash escape hatch against write-to-source commands while source is locked, confine reviewers to .sdd/ during non-workflow REVIEW/CHANGE_REVIEW (workflow paths skip via .workflow-in-flight marker), validate spec STATUS + required sections, validate product backlog STATUS + structure, validate bug-lane diagnosis.md STATUS + required sections, require reviewer REVIEW.md entries on non-workflow paths, refuse Stop on failing tests while a feature is active (bounded: escalates to ESCALATION.md after 3 consecutive red stops), reap orphaned .workflow-in-flight markers on Stop, cap spec.md/acceptance.md bytes at SPEC_MAX_KB and distinct acceptance criteria at AC_MAX (absent field = no cap; over budget means split the feature)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-source-before-finalized.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/restrict-reviewer-writes.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/require-reproducing-test.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/cap-spec-size.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-bash-writes.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-spec-status.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-backlog-status.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-diagnosis-status.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/validate-acceptance-count.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "(build-fleet:)?(architect|coder|qa|product-owner)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-review-written.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-tests.sh\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/reap-stale-workflow-markers.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
